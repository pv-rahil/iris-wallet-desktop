/* Multisig Setup Page Styles (page, not dialog) */

/* Card container (reuse Issue CFA card palette) */
QWidget#ms_page_card {
    background: transparent;
    background-color: rgb(3, 11, 37);
    border: 1px solid rgb(102, 108, 129);
    border-radius: 8px;
}

/* Title and section headers */
QLabel#ms_title {
    font: 24px "Inter";
    color: #D0D3DD;
    padding-bottom: 15px;
    padding-top: 15px;
    font-weight: 600;
}

QLabel#ms_section_title {
    font: 18px "Inter";
    color: #FFFFFF;
    font-weight: 450;
}

/* Secondary text labels */
QLabel#ms_label, QLabel#ms_helper {
    font: 14px "Inter";
    color: rgb(121, 128, 148);
    background: transparent;
    border: none;
    font-weight: 600;
}

QLabel#ms_helper {
    font-weight: 400;
}

QLineEdit#ms_input {
    padding-left: 10px;
    font: 15px "Inter";
    color: rgb(102, 108, 129);
    background-color: rgb(36, 44, 70);
    border: transparent;
    border-radius: 4px;
}

/* Scrollable area for cosigners */
QScrollArea#ms_scroll {
    background: transparent;
    border: none;
}

QScrollArea#ms_scroll > QWidget > QWidget {
    background: transparent;
}

/* Small neutral action button (e.g., Paste) */
QPushButton#ms_small_btn {
    font: 13px "Inter";
    color: #D0D3DD;
    background-color: rgb(36, 44, 70);
    border: 1px solid rgba(88, 104, 113, 0.6);
    border-radius: 6px;
    padding: 4px 10px;
    margin-right: 6px;
}

QPushButton#ms_small_btn:hover {
    border-color: rgb(102, 160, 255);
}

QPushButton#ms_small_btn:pressed {
    background-color: rgb(28, 36, 58);
}

/* Error labels */
QLabel#ms_error {
    font: 12px "Inter";
    color: rgb(220, 120, 120);
    padding-top: 2px;
}

QFrame#above_line_frame, QFrame#below_line_frame {
    border: none;
    border-bottom: 1px solid rgb(27, 35, 59);
}

QPushButton#secondary_button {
    font: 15px "Inter";
    background: transparent;
    border: 1px solid #586871;
    color: #586871;
    border-radius: 4px;
    font-weight: 700;
}
QPushButton#secondary_button:hover {
    color: white;
    background-color: rgb(22, 88, 73);
    border: 1px solid rgb(1, 167, 129);
}
QPushButton#secondary_button:pressed {
    background-color: #3575a0;
}
QPushButton#secondary_button:disabled {
    font-weight: 600;
    border: 1px solid  #3e4d57;
    color: #3e4d57;
}
QPushButton#close_button {
    background: transparent;
    border: none;
}
QFrame#ms_info_box {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(208,211,221,0.15);
    border-radius: 10px;
}
QLabel#ms_info_badge {
    border-radius:11px;
    background: rgba(208,211,221,0.18);
    color:#D0D3DD;
    font-weight:700;
}
QFrame#ms_summary_box {
    background: rgba(255,255,255,0.02);
    border: 1px solid rgba(208,211,221,0.15);
    border-radius: 10px;
}
QPushButton#copy_button {
    color: rgb(102, 108, 129);
    background-color: rgb(36, 44, 70);
    border: transparent;
    border-radius: 4px;
    border-top-left-radius: 0px;
    border-bottom-left-radius: 0px;
}

QPushButton#copy_button:hover {
    color: rgb(149, 155, 174);
    background-color: rgb(27, 35, 59);
}

QLineEdit#wallet_detail_input {
    padding-left: 10px;
    font: 15px "Inter";
    color: rgb(102, 108, 129);
    background-color: rgb(36, 44, 70);
    border: transparent;
    border-radius: 4px;
}
