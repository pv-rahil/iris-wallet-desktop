/* Multisig Setup Page Styles (page, not dialog) */

/* Card container (reuse Issue CFA card palette) */
QWidget#ms_page_card {
    background: transparent;
    background-color: rgb(3, 11, 37);
    border: 1px solid rgb(102, 108, 129);
    border-radius: 8px;
}

/* Title and section headers */
QLabel#ms_title {
    font: 24px "Inter";
    color: #D0D3DD;
    padding-bottom: 15px;
    padding-top: 15px;
    font-weight: 600;
}

QLabel#ms_section_title {
    font: 18px "Inter";
    color: #FFFFFF;
    font-weight: 450;
}

/* Secondary text labels */
QLabel#ms_label, QLabel#ms_helper {
    font: 14px "Inter";
    color: rgb(121, 128, 148);
    background: transparent;
    border: none;
    font-weight: 600;
}

QLabel#ms_helper {
    font-weight: 400;
}

/* Input fields styled similar to issue CFA inputs */
QLineEdit#ms_input {
    padding: 10px 12px;
    font: 15px "Inter";
    background: none;
    color: #D0D3DD;
    background-color: rgb(36, 44, 70);
    border: 1px solid rgba(88, 104, 113, 0.5);
    border-radius: 6px;
    min-height: 36px;
}

QLineEdit#ms_input:focus {
    border: 1px solid rgb(102, 160, 255);
    outline: none;
}

/* SpinBoxes: mimic the darker input background */
QSpinBox#ms_spin {
    font: 15px "Inter";
    color: #D0D3DD;
    background-color: rgb(36, 44, 70);
    border: 1px solid rgb(88, 104, 113);
    border-radius: 6px;
    padding: 4px 8px;
}

/* Thin separators like issue_cfa */
QFrame#ms_divider {
    border: none;
    border-bottom: 1px solid rgb(27, 35, 59);
}

/* Scrollable area for cosigners */
QScrollArea#ms_scroll {
    background: transparent;
    border: none;
}

QScrollArea#ms_scroll > QWidget > QWidget {
    background: transparent;
}

/* Small inline remove button matching the theme */
QPushButton#ms_remove_btn {
    font: 13px "Inter";
    color: #D0D3DD;
    background-color: rgb(36, 44, 70);
    border: 1px solid rgba(88, 104, 113, 0.6);
    border-radius: 6px;
    padding: 4px 10px;
}

QPushButton#ms_remove_btn:hover {
    border-color: rgb(102, 160, 255);
}

QPushButton#ms_remove_btn:pressed {
    background-color: rgb(28, 36, 58);
}

/* Small neutral action button (e.g., Paste) */
QPushButton#ms_small_btn {
    font: 13px "Inter";
    color: #D0D3DD;
    background-color: rgb(36, 44, 70);
    border: 1px solid rgba(88, 104, 113, 0.6);
    border-radius: 6px;
    padding: 4px 10px;
    margin-right: 6px;
}

QPushButton#ms_small_btn:hover {
    border-color: rgb(102, 160, 255);
}

QPushButton#ms_small_btn:pressed {
    background-color: rgb(28, 36, 58);
}

/* Per-row divider */
QFrame#ms_row_divider {
    border: none;
    border-bottom: 1px solid rgb(27, 35, 59);
    margin-top: 10px;
}

/* Error labels */
QLabel#ms_error {
    font: 12px "Inter";
    color: rgb(220, 120, 120);
    padding-top: 2px;
}
