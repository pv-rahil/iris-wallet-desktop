
#refresh_transfer_dialog {
  /* Transparent window; rounded container draws the background */
  background-color: transparent;
  color: rgb(102, 108, 129);
}

/* Reset any inherited padding/margins inside the dialog to avoid layout drift */
#refresh_transfer_dialog QLabel,
#refresh_transfer_dialog QFrame {
  padding: 0;
  margin: 0;
}

/* Rounded container providing the actual dialog background */
#refresh_transfer_dialog QFrame#container_frame {
  background-color: #1B233B;
  border: 1px solid rgba(102, 108, 129, 0.6);
  border-radius: 12px;
}

/* Header title */
#refresh_transfer_dialog #title_label {
  color: #ffffff;
  font-family: "Inter";
  font-size: 18px;
  font-weight: 700;
  border: none;
}

/* Close button (top-right) */
#refresh_transfer_dialog QPushButton#close_btn {
  border: none;
  background: transparent;
}

/* Section/card frame for each transfer item */
#refresh_transfer_dialog QFrame#transfer_frame {
  background-color: #030B25;
  border: 1px solid rgba(255,255,255,0.06);
  border-radius: 10px;
}
/* Status chip */
#refresh_transfer_dialog QLabel#status_chip {
  background: rgba(244, 95, 108, 0.18);
  color: #ffb3b8;
  border: 1px solid rgba(244,95,108,0.45);
  border-radius: 12px;
  padding: 4px 14px;
  font-family: "Inter";
  font-size: 14px;
  font-weight: 700;
  min-width: 96px;
}

#refresh_transfer_dialog QLabel#failure_label,
#refresh_transfer_dialog QLabel#failure_value_label,
#refresh_transfer_dialog QLabel#reason_label,
#refresh_transfer_dialog QLabel#asset_id_value_label,
#refresh_transfer_dialog QLabel#asset_id_label {
  font-family: "Inter";
  font-size: 14px;
  font-weight: 500;
  color: rgb(102, 108, 129); /* soft red */
}

/* Monospace for IDs for better readability */
#refresh_transfer_dialog QLabel#asset_id_value_label {
  font-family: "JetBrains Mono", "Fira Code", monospace;
  color: #cbd5e1;
}

#refresh_transfer_dialog QScrollArea#scroll_area_1 {
  background-color: transparent;
  padding: 6px 2px 10px 2px;
}
#refresh_transfer_dialog QFrame#scroll_area_widget_1 {
  background-color: transparent;
}

/* Code-style container for Asset ID */
#refresh_transfer_dialog QFrame#code_container {
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 8px;
}
#refresh_transfer_dialog QFrame#code_container QLabel#asset_id_value_label {
  color: #d5dbea;
}
