/* Styles for the logo title image */
QLabel#logo_title_img {
    background: transparent;
    border: none;
}

/* Styles for the logo title text */
QLabel#logo_title {
    font: 24px "Inter";
    font-weight: 600;
    color: white;
}

/* Styles for the issue NIA widget */
QWidget#issue_nia_widget {
    background: transparent;
    background-color: rgb(3, 11, 37);
    border: 1px solid rgb(102, 108, 129);
    border-radius: 8px;

}

/* Styles for line edit elements within the issue NIA widget */
QLineEdit#issue_nia_input, QLineEdit#asset_name_input, QLineEdit#amount_input {
    padding-left: 10px;
    font: 15px "Inter";
    color: rgb(102, 108, 129);
    background-color: rgb(36, 44, 70);
    border: transparent;
    border-radius: 4px;
}

/* Styles for label elements within the issue NIA widget */
QLabel#issue_nia_label, QLabel#asset_ticker_label, QLabel#asset_name_label, QLabel#total_supply_label, QLabel#fee_rate_label {
    font: 14px "Inter";
    color: rgb(121, 128, 148);
    background: transparent;
    border: none;
    font-weight: 600;
}

/* Styles for the issue NIA title */
QLabel#set_wallet_password_label {
    font: 24px "Inter";
    border: none;
    padding-bottom: 15px;
    padding-top: 15px;
    color: rgb(208, 211, 221);
    background: transparent;

}

/* Styles for the NIA close button */
QPushButton#close_btn {
    background: transparent;
    border: none;
}

QFrame#issue_nia_wallet_logo{
    border:none
}

/* Styles for line elements within the issue NIA widget */
QFrame#line_3, QFrame#bottom_line_frame {
    border: none;
    border-bottom: 1px solid rgb(27, 35, 59);
}

/* Checkbox styling aligned with Send page */
QCheckBox#replace_label_checkbox {
    font: 14px "Inter";
    color: rgba(102, 108, 129, 1);
    border: none;
}

QCheckBox#replace_label_checkbox::indicator {
    width: 15px;
    height: 15px;
    border: 2px solid rgba(1, 167, 129, 1);
    border-radius: 4px;
}

QCheckBox#replace_label_checkbox::indicator:unchecked {
    background-color: transparent;
}

QCheckBox#replace_label_checkbox::indicator:checked {
    background-color: green;
}

/* Info icon beside Total Supply (used in IFA/NIA issue forms) */
QPushButton#total_supply_info_btn {
    background: transparent;
    border: none;
    min-width: 22px;
    min-height: 22px;
    max-width: 22px;
    max-height: 22px;
    padding: 0px;
    margin-left: 4px; /* keep tight to label */
}

QPushButton#total_supply_info_btn:hover {
    opacity: 0.9;
}

/* Tooltip readability */
QToolTip {
    background-color: #FFFFFF;
    color: #0A0F1F;
    border: 1px solid #D0D3DD;
    padding: 4px 4px;
    font: 13px "Inter";
}
